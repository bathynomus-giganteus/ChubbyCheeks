    "CULTLEADERMOD-PURE_COME_TO_MAIDENS_SIDE.title": "Come to the Maiden's Side?",
    "CULTLEADERMOD-PURE_COME_TO_MAIDENS_SIDE.description": "Gain {Block:diff()} Block and {RegenPower:diff()} [gold]Regen[/gold].",
    "CULTLEADERMOD-PURE_ENCIRCLEMENT_HUNT.title": "Encirclement Hunt",
    "CULTLEADERMOD-PURE_ENCIRCLEMENT_HUNT.description": "Deal {Damage:diff()} damage 3 times. If target HP is less than your max HP, trigger once more.",
    "CULTLEADERMOD-PURE_VACATION_ESCAPE.title": "Vacation Escape",
    "CULTLEADERMOD-PURE_VACATION_ESCAPE.description": "Gain {RegenPower:diff()} [gold]Regen[/gold]. Gain {Block:diff()} Block for each [gold]Regen[/gold] or [gold]Life Essence[/gold] stack.",
    "CULTLEADERMOD-PURE_STRONGEST_COLLECTIBLE.title": "Strongest Collectible",
    "CULTLEADERMOD-PURE_STRONGEST_COLLECTIBLE.description": "Deal {Damage:diff()} damage. If total [gold]Regen[/gold] and [gold]Life Essence[/gold] stacks exceed 10, Stun all other enemies.",
    "CULTLEADERMOD-PURE_PUMPKIN_MAGIC.title": "Pumpkin Magic",
    "CULTLEADERMOD-PURE_PUMPKIN_MAGIC.description": "Gain 2 [gold]Regen[/gold] and 5 Block.",
    "CULTLEADERMOD-PURE_PROTECT_YOU.title": "\"I'll... protect you...\"",
    "CULTLEADERMOD-PURE_PROTECT_YOU.description": "Gain {RegenPower:diff()} [gold]Regen[/gold] and {Block:diff()} Block. Draw {Draw:diff()} card.",
    "CULTLEADERMOD-PURE_MISCHIEVOUS_SMILE.title": "Mischievous Smile",
    "CULTLEADERMOD-PURE_MISCHIEVOUS_SMILE.description": "Target enemy gains {WeakPower:diff()} [gold]Weak[/gold]. Gain [gold]Regen[/gold] equal to its debuff count. Then this card's cost +1 this combat{IfUpgraded:show:| (negated by upgrade)}.",
    "CULTLEADERMOD-PURE_MARGOMA_RECOVERY.title": "Margoma Recovery",
    "CULTLEADERMOD-PURE_MARGOMA_RECOVERY.description": "If [gold]Regen[/gold] is less than 5, gain {RegenPower:diff()} [gold]Regen[/gold]; if 5 or more, trigger Regen 3 times and draw 2 cards.",
    "CULTLEADERMOD-PURE_WITCH_ARCHIVE.title": "Witch Archive",
    "CULTLEADERMOD-PURE_WITCH_ARCHIVE.description": "Gain [gold]Regen[/gold] equal to the number of Pure Apostle cards in your deck.",
    "CULTLEADERMOD-PURE_NON_GRATA.title": "Non Grata",
    "CULTLEADERMOD-PURE_NON_GRATA.description": "Deal {Damage:diff()} damage. If you have at least 2 [gold]Regen[/gold] or [gold]Life Essence[/gold], consume 2 and deal {BonusDamage:diff()} more damage.",
    "CULTLEADERMOD-PURE_WATERS_BAPTISM.title": "Accept the Water's Baptism!",
    "CULTLEADERMOD-PURE_WATERS_BAPTISM.description": "Trigger [gold]Regen[/gold] or [gold]Life Essence[/gold] 2{IfUpgraded:show:3} times. Deal damage to ALL enemies equal to HP restored.",
    "CULTLEADERMOD-PURE_SAP_PUMP.title": "Sap Pump Fire!",
    "CULTLEADERMOD-PURE_SAP_PUMP.description": "Whenever you heal HP, deal {Damage:diff()} damage to a random enemy.",
    "CULTLEADERMOD-PURE_DIAMOND_PIERCE.title": "Diamond Pierce",
    "CULTLEADERMOD-PURE_DIAMOND_PIERCE.description": "Deal {Damage:diff()}+[gold]Regen[/gold]/[gold]Life Essence[/gold] stacks damage to ALL enemies. If this kills an enemy, trigger again.",
    "CULTLEADERMOD-PURE_DODGE_THIS.title": "Dodge This!!! Eh...?",
    "CULTLEADERMOD-PURE_DODGE_THIS.description": "Deal {Damage:diff()} damage to ALL enemies. Stun self, ending this turn and skipping the next.",
    "CULTLEADERMOD-PURE_OPAL_DUST.title": "Opal Dust",
    "CULTLEADERMOD-PURE_OPAL_DUST.description": "Gain {IfUpgraded:show:2|1} Block for each [gold]Regen[/gold] and [gold]Life Essence[/gold] stack.",
    "CULTLEADERMOD-PURE_REMOTE_CHARGING.title": "Remote Charging",
    "CULTLEADERMOD-PURE_REMOTE_CHARGING.description": "Every {IfUpgraded:show:3|4} times you heal HP, gain 1 [gold]Energy[/gold].",
    "CULTLEADERMOD-PURE_SUDDEN_SHOCK.title": "Sudden Shock",
    "CULTLEADERMOD-PURE_SUDDEN_SHOCK.description": "Gain 1 [gold]Buffer[/gold]. If total Regen+Life Essence >= 5, gain another.",
    "CULTLEADERMOD-PURE_BASIC_HACK.title": "Basic Hack Attack",
    "CULTLEADERMOD-PURE_BASIC_HACK.description": "Deal damage equal to [gold]Regen[/gold] or [gold]Life Essence[/gold] stacks. Enemy loses that much [gold]Strength[/gold] this turn.",
    "CULTLEADERMOD-PURE_HELP_ME_FRIENDS.title": "Help Me, Friends!",
    "CULTLEADERMOD-PURE_HELP_ME_FRIENDS.description": "Gain 1 [gold]Temporary Strength[/gold] for each Regen/Life Essence stack, then deal {Damage:diff()} damage to ALL enemies.",
