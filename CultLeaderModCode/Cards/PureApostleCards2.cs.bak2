/// <summary>Daya — Diamond Pierce</summary>
public sealed class PureDiamondPierce() :
    CultLeaderModCard(2, CardType.Attack, CardRarity.Uncommon, TargetType.AllEnemies), IApostleCard
{
    public ApostlePersonality Personality => ApostlePersonality.Pure;
    public string ApostleName => "达雅";
    public override string? StarIconPath => "res://CultLeaderMod/images/apostle_icons/daya_avatar.png";
    public override string CustomPortraitPath => "res://CultLeaderMod/images/card_portraits/big/daya_card.png";
    public override string PortraitPath => "res://CultLeaderMod/images/card_portraits/pure/daya_card.png";
    public override string BetaPortraitPath => PortraitPath;
    protected override IEnumerable<DynamicVar> CanonicalVars => [new DamageVar(10m, ValueProp.Move)];

    private async Task ExecuteAttack(PlayerChoiceContext ctx, CardPlay cardPlay)
    {
        var enemies = CombatState!.Enemies.Where(e => !e.IsDead).ToList();
        if (enemies.Count == 0) return;
        decimal dmg = DynamicVars.Damage.BaseValue + ApostleCardHelper.TotalRegenStacks(Owner.Creature);
        foreach (var enemy in enemies)
            await DamageCmd.Attack(dmg).FromCard(this, cardPlay).Targeting(enemy).Execute(ctx);
    }

    protected override async Task OnPlay(PlayerChoiceContext choiceContext, CardPlay cardPlay)
    {
        await ExecuteAttack(choiceContext, cardPlay);
        bool anyDead = CombatState!.Enemies.Any(e => e.IsDead);
        if (anyDead)
            await ExecuteAttack(choiceContext, cardPlay);
    }
    protected override void OnUpgrade() => DynamicVars.Damage.UpgradeValueBy(3m);
}

