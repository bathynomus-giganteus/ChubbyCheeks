<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <Import Project=".\Sts2PathDiscovery.props"/>
    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework><ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase><PathMap>$(AppOutputBase)=.\</PathMap>
        <GodotDisabledSourceGenerators>GodotPluginsInitializer</GodotDisabledSourceGenerators>
        <RitsuLibDeployDir>$(Sts2Dir)/mods/STS2-RitsuLib/</RitsuLibDeployDir>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>
    <PropertyGroup><NoWarn>$(NoWarn);MSB3270</NoWarn></PropertyGroup>
    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony"><HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="sts2"><HintPath>$(Sts2DataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="STS2.RitsuLib" Version="0.5.13" PrivateAssets="All"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <AdditionalFiles Include="CultLeaderMod/localization/**/*.json"/>
        <CultLeaderModLocalizationFiles Include="CultLeaderMod/localization/**/*.json"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Remove=".godot/**" />
        <Compile Remove="CultLeaderMod/**" />
        <Compile Remove="CultLeaderModCode/MainFile.cs" />
        <Compile Remove="CultLeaderModCode/Extensions/**" />
        <Compile Remove="CultLeaderModCode/Potions/CultLeaderModPotion.cs" />
        <Compile Remove="CultLeaderModCode/Powers/CultLeaderModPower.cs" />
        <Compile Remove="Scripts/**" />
        <Compile Remove="tmp/**" />
        <EmbeddedResource Remove="CultLeaderMod/**" />
    </ItemGroup>
    <ItemGroup>
        <None Include="CultLeaderMod.json" /><None Include="project.godot"/><None Include="CultLeaderMod/**" />
    </ItemGroup>
    <Target Name="CheckDependencyPaths">
        <Error Text="STS2 data not found" Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')" />
    </Target>
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
        <Message Text="Copying mod..." Importance="high" />
        <MakeDir Directories="$(ModsPath)CultLeaderMod/" />
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)CultLeaderMod/" />
        <Copy SourceFiles="CultLeaderMod.json" DestinationFolder="$(ModsPath)CultLeaderMod/" />
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb" DestinationFolder="$(ModsPath)CultLeaderMod/" />
        <Copy SourceFiles="@(CultLeaderModLocalizationFiles)" DestinationFiles="@(CultLeaderModLocalizationFiles->'$(ModsPath)CultLeaderMod/CultLeaderMod/localization/%(RecursiveDir)%(Filename)%(Extension)')" />
    </Target>

    <Target Name="SyncSpinePublishAssets" AfterTargets="CopyToModsFolderOnBuild" Condition="Exists('E:\work\Cult_leader_mod\SPINE_4_2_TEST')">
        <Message Text="Syncing bundled Spine assets for local mod and Workshop staging..." Importance="high" />
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Scripts\Sync-SpinePublishAssets.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)&quot; -SourceRoot &quot;E:\work\Cult_leader_mod\SPINE_4_2_TEST&quot; -LocalModDir &quot;$(ModsPath)CultLeaderMod&quot; -WorkshopSubscriptionDir &quot;E:\SteamLibrary\steamapps\workshop\content\2868840\3784977251&quot; -WorkshopContentDir &quot;$(MSBuildProjectDirectory)\release\workshop\CultLeaderModWorkspace\content&quot;" />
    </Target>


    <Target Name="ExportPck">
        <Message Text="Exporting PCK to mods folder..." Importance="high" />
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;Windows Desktop&quot; &quot;$(ModsPath)CultLeaderMod/CultLeaderMod.pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue" />
    </Target>

</Project>
